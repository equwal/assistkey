# Build output
build/
.gradle/
*.apk
# The unchanged release APKs of other makers that the full build carries.
!app/src/full/assets/bundled/*.apk
*.aab
*.ap_
*.dex

# Local machine configuration
local.properties
build.ps1

# Signing material - the keystore and its passwords never go in the repo.
# Losing assistkey-release.jks means shipped installs can never be upgraded,
# so keep a backup somewhere outside this folder.
*.jks
*.keystore
keystore.properties

# Editors
.idea/
*.iml
.vscode/
.DS_Store
