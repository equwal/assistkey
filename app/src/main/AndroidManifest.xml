<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Not grantable at install. Declared so that `adb shell pm grant` can turn
        it on for the power-gesture switches; without it those rows report the
        refusal and print the command instead.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />


    <!--
        Voice typing only. The speech recognition app does the recording; Android
        still requires the app that asks for it to hold the permission. Requested
        at run time, from the Voice typing screen, and never otherwise.
    -->

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Required of any app that wants to be offered the wallet role. -->
    <uses-permission android:name="android.permission.QUICK_ACCESS_WALLET" />

    <!--
        Package visibility. We need to see launchable apps to offer them as
        targets, resolve the camera intent to tell whether we are the default,
        and reach the Viwoods AI activities by explicit component.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- Speech recognition apps, for voice typing. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Ink Recents, which the Recent apps action opens. -->
        <package android:name="dev.equwal.inkrecents" />
        <package android:name="com.viwoods.launcher" />
        <package android:name="com.viwoods.viwoodsai" />
        <package android:name="com.viwoods.settings" />
    </queries>

    <!--
        hasFragileUserData: on uninstall, Android asks the user whether to keep
        the data of the app. With the data kept, a new install has every setting.
    -->
    <application
        android:allowBackup="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <!-- Configuration UI -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.TriggerListActivity" android:exported="false" />
        <activity android:name=".ui.ActionPickerActivity" android:exported="false" />
        <activity android:name=".ui.PowerActivity" android:exported="false" />
        <activity android:name=".ui.ChordActivity" android:exported="false" />
        <activity android:name=".ui.ViwoodsActivity" android:exported="false" />
        <activity android:name=".ui.TimingActivity" android:exported="false" />
        <activity android:name=".ui.KeyTesterActivity" android:exported="false" />
        <activity android:name=".ui.LicenseActivity" android:exported="false" />
        <activity android:name=".ui.NavigationActivity" android:exported="false" />
        <activity android:name=".ui.ShellActivity" android:exported="false" />
        <activity android:name=".ui.DisplayActivity" android:exported="false" />
        <activity android:name=".ui.VoiceActivity" android:exported="false" />
        <activity android:name=".ui.BackupActivity" android:exported="false" />
        <activity android:name=".ui.PermissionsActivity" android:exported="false" />
        <!-- The hub's sub-screens. -->
        <activity android:name=".ui.KeysActivity" android:exported="false" />
        <activity android:name=".ui.SetupActivity" android:exported="false" />
        <activity android:name=".ui.HomeHubActivity" android:exported="false" />
        <activity android:name=".ui.AdvancedActivity" android:exported="false" />
        <activity android:name=".ui.HacksActivity" android:exported="false" />
        <!-- The guided flow the hub opens first. -->
        <activity android:name=".setup.GuidedSetupActivity" android:exported="false" />
        <activity android:name=".menu.MenuEditActivity" android:exported="false" />
        <!-- The action menu: a box over the app in front, in a task of its own. -->
        <activity
            android:name=".menu.MenuActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Invisible" />
        <!-- See-through and unfocusable: on top only so the microphone is allowed. -->
        <activity
            android:name=".voice.DictationActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Invisible" />
        <activity
            android:name=".home.RecentsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Invisible" />

        <activity android:name=".ui.ReportActivity" android:exported="false" />
        <activity android:name=".ui.DetectActivity" android:exported="false" />

        <!--
            The three impersonation entry points. Each starts disabled: the app
            must not show up as an assistant, camera or wallet candidate until
            the user ticks that channel. Channels.syncComponents flips them.
        -->

        <!--
            Long-pressing Power fires ACTION_ASSIST at whichever app holds the
            assistant role. Invisible, no-history, no task affinity, so nothing
            is drawn and nothing lands in Recents.
        -->
        <activity
            android:name=".channel.AssistActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Target for the firmware's own AI key hook (Settings.System
            CustomAiKey), which only the shell can set. No intent filter: it is
            reached by explicit component, and only by the firmware. Always
            enabled, because the hook outlives any switch inside the app.
        -->
        <activity
            android:name=".channel.AiKeyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Invisible" />

        <!-- Double press Power, when the firmware target is the camera. -->
        <activity
            android:name=".channel.CameraShimActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Invisible">
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Double press Power when the target is the wallet, plus the QS tile. -->
        <activity
            android:name=".channel.WalletActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Invisible">
            <intent-filter>
                <action android:name="android.service.quickaccesswallet.action.VIEW_WALLET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The wallet role is not offered to an app that cannot serve cards, so
            this exists to satisfy the requirement. It serves none.
        -->
        <service
            android:name=".channel.WalletService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/wallet_label"
            android:permission="android.permission.BIND_QUICK_ACCESS_WALLET_SERVICE">
            <intent-filter>
                <action android:name="android.service.quickaccesswallet.QuickAccessWalletService" />
            </intent-filter>
            <meta-data
                android:name="android.quickaccesswallet"
                android:resource="@xml/quick_access_wallet" />
        </service>

        <!--
            The accessibility channel. This is the only component that sees the
            AI key and the volume keys; Power never reaches it.
        -->
        <service
            android:name=".engine.KeyFilterService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
