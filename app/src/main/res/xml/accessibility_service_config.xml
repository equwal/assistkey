<?xml version="1.0" encoding="utf-8"?>
<!--
    flagRequestFilterKeyEvents plus canRequestFilterKeyEvents is the whole
    point: without both, onKeyEvent is never called and no key can be
    intercepted. Window content is needed only for the scroll action, and
    gesture dispatch only for the synthetic page-turn swipes.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRequestFilterKeyEvents|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRequestFilterKeyEvents="true"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:notificationTimeout="100"
    android:settingsActivity="dev.equwal.assistkey.ui.MainActivity" />
